# Server
PORT=3005
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# WebSocket
WS_PATH=/ws

# CricHeroes import (optional). Defaults to the public web API and the key the
# CricHeroes website itself uses; only set these if they change.
# CRICHEROES_API_BASE=https://api.cricheroes.in
# CRICHEROES_API_KEY=
